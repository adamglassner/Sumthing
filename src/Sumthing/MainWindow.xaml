<Window x:Class="Sumthing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Sumthing.Views"
        Style="{StaticResource AppWindow}"
        Title="Sumthing" Icon="Assets/sumthing.ico"
        Width="360" Height="600" MinWidth="240" MinHeight="330"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Classic look: menu bar like the Windows 7 calculator ===== -->
        <Menu x:Name="ClassicMenu" Grid.ColumnSpan="2" Style="{StaticResource MenuBar}" Padding="2,0" Visibility="Collapsed">
            <MenuItem Header="_View" Style="{StaticResource TopMenuItem}">
                <MenuItem x:Name="MenuStandard" Header="_Standard" InputGestureText="Ctrl+1" Tag="Standard" Click="MenuMode_Click"/>
                <MenuItem x:Name="MenuSums" Header="_Type-a-sum" InputGestureText="Ctrl+2" Tag="Sums" Click="MenuMode_Click"/>
                <MenuItem x:Name="MenuConverter" Header="_Converter" InputGestureText="Ctrl+3" Tag="Converter" Click="MenuMode_Click"/>
                <MenuItem x:Name="MenuTools" Header="_Everyday tools" InputGestureText="Ctrl+4" Tag="Tools" Click="MenuMode_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuTape" Header="T_ape" InputGestureText="Ctrl+T" Click="TapeToggle_Click"/>
                <MenuItem x:Name="MenuHistory" Header="_History" InputGestureText="Ctrl+H" Click="History_Click"/>
                <Separator/>
                <MenuItem Header="_Look">
                    <MenuItem x:Name="MenuThemeSystem" Header="Follow _Windows (modern)" Tag="System" Click="MenuTheme_Click"/>
                    <MenuItem x:Name="MenuThemeLight" Header="_Light" Tag="Light" Click="MenuTheme_Click"/>
                    <MenuItem x:Name="MenuThemeDark" Header="_Dark" Tag="Dark" Click="MenuTheme_Click"/>
                    <MenuItem x:Name="MenuThemeClassic" Header="_Classic" Tag="Classic" Click="MenuTheme_Click"/>
                </MenuItem>
                <MenuItem x:Name="MenuOnTop" Header="Keep on _top" Click="Pin_Click"/>
                <Separator/>
                <MenuItem Header="Se_ttings..." Tag="Settings" Click="MenuMode_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                <Separator/>
                <MenuItem Header="Copy t_ape" Click="CopyTape_Click"/>
                <MenuItem Header="C_lear tape" Click="ClearTape_Click"/>
                <MenuItem Header="Clear _history" Click="ClearHistory_Click"/>
            </MenuItem>
            <MenuItem Header="_Help" Style="{StaticResource TopMenuItem}">
                <MenuItem Header="_Keyboard shortcuts" Click="Shortcuts_Click"/>
                <Separator/>
                <MenuItem Header="_About Sumthing" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===== Modern looks: header with the navigation button ===== -->
        <Grid x:Name="Header" Grid.Row="1" Margin="4,4,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="NavButton" Style="{StaticResource IconButton}" Width="40" Height="40" Click="Nav_Click"
                    ToolTip="Open navigation" AutomationProperties.Name="Open navigation">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE700;"/>
            </Button>
            <TextBlock x:Name="ModeTitle" Grid.Column="1" Text="Standard" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="6,0,0,2" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ToggleButton x:Name="PinToggle" Style="{StaticResource IconToggle}" Width="40" Height="40" Click="Pin_Click"
                              ToolTip="Keep on top" AutomationProperties.Name="Keep on top">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE718;" FontSize="15"/>
                </ToggleButton>
                <ToggleButton x:Name="TapeToggle" Style="{StaticResource IconToggle}" Width="40" Height="40" Click="TapeToggle_Click"
                              ToolTip="Tape (Ctrl+T)" AutomationProperties.Name="Tape">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="15"/>
                </ToggleButton>
                <Button x:Name="HistoryButton" Style="{StaticResource IconButton}" Width="40" Height="40" Click="History_Click"
                        ToolTip="History (Ctrl+H)" AutomationProperties.Name="History">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== The modes ===== -->
        <Grid x:Name="Host" Grid.Row="2">
            <v:StandardView x:Name="StandardPage"/>
            <v:SumsView x:Name="SumsPage" Visibility="Collapsed"/>
            <v:ConverterView x:Name="ConverterPage" Visibility="Collapsed"/>
            <v:ToolsView x:Name="ToolsPage" Visibility="Collapsed"/>
            <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed"/>
        </Grid>

        <!-- ===== Tape (paper roll) on the right ===== -->
        <v:TapePanel x:Name="TapePage" Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Width="290" Visibility="Collapsed"/>

        <!-- ===== Navigation pane (slides over the content) ===== -->
        <Grid x:Name="NavLayer" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border Background="#33000000" MouseLeftButtonDown="NavDismiss_MouseDown"/>
            <Border x:Name="NavPane" Width="250" HorizontalAlignment="Left" Background="{DynamicResource MenuBg}"
                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="0,0,1,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25" Direction="0"/>
                </Border.Effect>
                <DockPanel Margin="0,4,0,8">
                    <Button DockPanel.Dock="Top" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="4,0,0,4"
                            HorizontalAlignment="Left" Click="Nav_Click" ToolTip="Close navigation" AutomationProperties.Name="Close navigation">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE700;"/>
                    </Button>
                    <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" GroupName="nav" Tag="Settings" Click="NavItem_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,14,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <StackPanel>
                        <TextBlock Text="Calculator" Margin="18,6,0,4" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                        <RadioButton x:Name="NavStandard" Style="{StaticResource NavItem}" GroupName="nav" Tag="Standard" Click="NavItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8EF;" Margin="0,0,14,0"/>
                                <TextBlock Text="Standard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSums" Style="{StaticResource NavItem}" GroupName="nav" Tag="Sums" Click="NavItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Margin="0,0,14,0"/>
                                <TextBlock Text="Type-a-sum" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Text="More" Margin="18,14,0,4" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                        <RadioButton x:Name="NavConverter" Style="{StaticResource NavItem}" GroupName="nav" Tag="Converter" Click="NavItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Margin="0,0,14,0"/>
                                <TextBlock Text="Converter" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" GroupName="nav" Tag="Tools" Click="NavItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" Margin="0,0,14,0"/>
                                <TextBlock Text="Everyday tools" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
