<Window x:Class="Sumthing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Sumthing.Views"
        Title="Sumthing"
        Icon="pack://application:,,,/Assets/sumthing.ico"
        Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid x:Name="Root" Background="{DynamicResource Brush.Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border x:Name="Sidebar" Background="{DynamicResource Brush.Sidebar}" Padding="16,20,16,14">
            <DockPanel>
                <!-- Logo -->
                <DockPanel DockPanel.Dock="Top" Margin="4,0,0,18">
                    <Button x:Name="CollapseButton" DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Padding="6" MinHeight="30"
                            Foreground="{DynamicResource Brush.SidebarMuted}" Click="Collapse_Click" VerticalAlignment="Center"
                            ToolTip="Collapse the sidebar (Ctrl+B)" AutomationProperties.Name="Collapse the sidebar">
                        <TextBlock x:Name="CollapseGlyph" Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="14"/>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/sumthing-256.png" Width="34" Height="34" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Wordmark" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center">
                            <Run Text="Sum" Foreground="{DynamicResource Brush.SidebarText}"/><Run Text="thing" Foreground="{DynamicResource Brush.Highlight}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- Bottom: answer card, compact, theme, settings -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border x:Name="AnsCard" Background="{DynamicResource Brush.SidebarCard}" CornerRadius="14" Padding="14,12" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Mint}"/>
                                <TextBlock Text="Last answer" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SidebarText}"/>
                            </StackPanel>
                            <TextBlock x:Name="AnsText" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource Brush.SidebarText}"/>
                            <TextBlock x:Name="AnsDetail" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.SidebarMuted}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="CompactButton" Style="{StaticResource SidebarButton}" Click="Compact_Click" ToolTip="Shrink to a small calculator (Ctrl+Shift+M)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE92C;" Style="{StaticResource Icon}" FontSize="16" Width="30"/>
                            <TextBlock x:Name="CompactLabel" Text="Compact calculator" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ThemeButton" Style="{StaticResource SidebarButton}" Click="Theme_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeGlyph" Style="{StaticResource Icon}" FontSize="16" Width="30"/>
                            <TextBlock x:Name="ThemeLabel" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource SidebarButton}" Click="Settings_Click" ToolTip="Settings (Ctrl+,)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="16" Width="30"/>
                            <TextBlock x:Name="SettingsLabel" Text="Settings" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="Heading1" Text="CALCULATE" FontSize="11" FontWeight="SemiBold" Margin="14,0,0,6" Foreground="{DynamicResource Brush.SidebarHeading}"/>
                        <ItemsControl x:Name="NavCalc" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource NavRadio}" GroupName="MainNav" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 ToolTip="{Binding Tagline}" AutomationProperties.Name="{Binding Name}" Checked="Nav_Checked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="Heading2" Text="TOOLS" FontSize="11" FontWeight="SemiBold" Margin="14,14,0,6" Foreground="{DynamicResource Brush.SidebarHeading}"/>
                        <ItemsControl x:Name="NavTools" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource NavRadio}" GroupName="MainNav" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 ToolTip="{Binding Tagline}" AutomationProperties.Name="{Binding Name}" Checked="Nav_Checked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- page header -->
            <DockPanel x:Name="PageHeader" Margin="36,26,36,18">
                <StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HeaderCompact" Style="{StaticResource GhostButton}" Click="Compact_Click" ToolTip="Shrink to a small calculator (Ctrl+Shift+M)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE92C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Compact"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitle}" Text="Standard"/>
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </DockPanel>

            <!-- compact-mode bar (replaces the header) -->
            <DockPanel x:Name="CompactBar" Margin="10,8,10,4" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="PinToggle" Style="{StaticResource IconToggle}" Width="34" MinWidth="34" Height="34" Margin="0,0,6,0"
                                  Click="Pin_Click" ToolTip="Keep on top" AutomationProperties.Name="Keep on top">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE718;" FontSize="14"/>
                    </ToggleButton>
                    <Button Style="{StaticResource IconButton}" Width="34" Height="34" Margin="0,0,6,0" Click="CompactHistory_Click"
                            ToolTip="History (Ctrl+H)" AutomationProperties.Name="History">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="34" Height="34" Click="Compact_Click"
                            ToolTip="Back to the full window (Ctrl+Shift+M)" AutomationProperties.Name="Full window">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE92D;" FontSize="14"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/sumthing-256.png" Width="20" Height="20" Margin="2,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center">
                        <Run Text="Sum"/><Run Text="thing" Foreground="{DynamicResource Brush.Accent}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- pages -->
            <Grid x:Name="PageHost" Grid.Row="1" Margin="36,0,36,24">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PageShift"/>
                </Grid.RenderTransform>
                <v:StandardView x:Name="StandardPage"/>
                <v:ScientificView x:Name="ScientificPage" Visibility="Collapsed"/>
                <v:GraphView x:Name="GraphPage" Visibility="Collapsed"/>
                <v:StatsView x:Name="StatsPage" Visibility="Collapsed"/>
                <v:SumsView x:Name="SumsPage" Visibility="Collapsed"/>
                <v:ConverterView x:Name="ConverterPage" Visibility="Collapsed"/>
                <v:ToolsView x:Name="ToolsPage" Visibility="Collapsed"/>
                <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed"/>
            </Grid>

            <!-- status bar -->
            <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0" Padding="18,6">
                <DockPanel>
                    <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11.5"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="11.5"/>
                </DockPanel>
            </Border>

            <!-- toast -->
            <Border x:Name="Toast" Grid.RowSpan="3" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,48"
                    Background="{DynamicResource Brush.ToastBg}" CornerRadius="12" Padding="16,12" MaxWidth="460">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastShift"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Mint}"/>
                    <TextBlock x:Name="ToastText" Foreground="{DynamicResource Brush.ToastText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
