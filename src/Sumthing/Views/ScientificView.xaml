<UserControl x:Class="Sumthing.Views.ScientificView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Sumthing.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.05*" MinWidth="380" MaxWidth="470"/>
        </Grid.ColumnDefinitions>

        <!-- ===== home screen ===== -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,16,14,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton x:Name="DegToggle" Style="{StaticResource IconToggle}" Margin="0,0,6,0" Click="Deg_Click"
                                      ToolTip="Angle mode: click to switch between radians and degrees">
                            <TextBlock x:Name="DegText" Text="RAD" FontWeight="SemiBold" FontSize="12.5"/>
                        </ToggleButton>
                        <Button Style="{StaticResource GhostButton}" Padding="10,0" Height="36" MinHeight="0" Click="ClearScreen_Click" ToolTip="Clear the screen (history)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Clear"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Home screen" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                </DockPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Enter" Margin="10,0,0,0" Click="Enter_Click" MinWidth="86"/>
                        <TextBox x:Name="Entry" FontFamily="Cambria Math, Segoe UI" FontSize="19" MinHeight="44" Padding="12,6"
                                 PreviewKeyDown="Entry_PreviewKeyDown" AutomationProperties.Name="Expression"/>
                    </DockPanel>
                </Border>

                <Grid>
                    <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                        <TextBlock Text="Type a calculation and press Enter" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" MaxWidth="420"
                                   Text="Like a TI-84: 2sin(30°), 7 nCr 3, √(2)►Frac, 5→A then A²+1, {3,5,8}→L1 then mean(L1), nDeriv(x³,x,2), fnInt(x²,x,0,3). Start a line with + − × ÷ to carry on from Ans. Up arrow brings back earlier lines."/>
                    </StackPanel>
                    <ListBox x:Name="Screen" Padding="12,0,12,8" SelectionChanged="Screen_SelectionChanged"
                             VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="History">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,6">
                                    <TextBlock Text="{Binding Input}" FontFamily="Cambria Math, Segoe UI" FontSize="15.5" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Exact}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="15" Margin="0,0,14,0"
                                                   VerticalAlignment="Bottom" FontFamily="Cambria Math, Segoe UI"/>
                                        <TextBlock Text="{Binding Output}" FontSize="21" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                                                   TextWrapping="Wrap" TextAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                                            <Setter Property="FontSize" Value="14"/>
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== keypad + variables ===== -->
        <DockPanel Grid.Column="2">
            <Border x:Name="VarCard" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,14">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Clear all" Click="ClearVars_Click"/>
                        <TextBlock Text="STORED VALUES" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="NoVars" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Nothing stored. Type 5→A (STO→) to keep a value; it works on the Graphing page too."/>
                    <ItemsControl x:Name="VarList" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BaseButton}" Margin="0,0,6,6" Padding="10,4" MinHeight="0" Tag="{Binding Key}"
                                        Background="{DynamicResource Brush.SurfaceAlt}" Click="Var_Click" ToolTip="Insert">
                                    <TextBlock FontSize="13"><Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" = "/><Run Text="{Binding Value, Mode=OneWay}"/></TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CalcBg}" BorderBrush="{DynamicResource CalcBorder}" BorderThickness="1"
                    CornerRadius="{DynamicResource CalcRadius}" Padding="10">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="3,0,3,6">
                        <Button x:Name="MathMenuButton" Style="{StaticResource ToolButton}" Click="MathMenu_Click" ToolTip="More functions (like the TI MATH menu)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MATH" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="7,1,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StatMenuButton" Style="{StaticResource ToolButton}" Click="StatMenu_Click" ToolTip="Statistics and probability">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="STAT · PROB" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="7,1,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CalcMenuButton" Style="{StaticResource ToolButton}" Click="CalcMenu_Click" ToolTip="Calculus">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CALC" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="7,1,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <UniformGrid x:Name="Pad" Columns="6" Rows="8"/>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
