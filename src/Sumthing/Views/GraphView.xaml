<UserControl x:Class="Sumthing.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Sumthing.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition x:Name="SideColumn" Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Functions + sliders ================= -->
        <DockPanel>
            <Border x:Name="SliderCard" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="SLIDERS" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl x:Name="SliderList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontStyle="Italic" FontSize="15" Width="22" VerticalAlignment="Center"
                                               FontFamily="Cambria Math, Segoe UI"/>
                                    <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value, Mode=TwoWay}"
                                            SmallChange="{Binding Step}" LargeChange="{Binding Step}" Margin="0,0,8,0"
                                            AutomationProperties.Name="{Binding Name}"/>
                                    <TextBox Grid.Column="2" Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MinHeight="30"
                                             Padding="6,3" FontSize="12.5" KeyDown="SliderBox_KeyDown" AutomationProperties.Name="Slider value"/>
                                    <ToggleButton Grid.Column="3" Style="{StaticResource IconToggle}" Width="30" MinWidth="30" Height="30" Margin="6,0,0,0"
                                                  IsChecked="{Binding Playing, Mode=TwoWay}" ToolTip="Animate" AutomationProperties.Name="Animate">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"/>
                                    </ToggleButton>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,14,10,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,0" Height="32" MinHeight="0"
                                Click="AddRow_Click" ToolTip="Add a function" AutomationProperties.Name="Add a function">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Add"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Functions" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- symbol palette (like the Nspire's template keys) -->
                    <WrapPanel x:Name="Palette" DockPanel.Dock="Bottom" Margin="0,8,0,0"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <ItemsControl x:Name="RowList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="8,8,6,8" CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Left" Width="22" Height="22" MinHeight="0" Padding="0" Margin="0,0,8,0"
                                                        Style="{StaticResource BaseButton}" Click="RowColor_Click" Tag="{Binding}"
                                                        ToolTip="Colour and line style" AutomationProperties.Name="Colour and line style">
                                                    <Grid>
                                                        <Ellipse Width="16" Height="16" Fill="{Binding ColorBrush}"/>
                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.SurfaceAlt}" Visibility="{Binding HiddenDot}"/>
                                                    </Grid>
                                                </Button>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Width="26" Height="26" MinHeight="0" Padding="0"
                                                        Click="DeleteRow_Click" Tag="{Binding}" ToolTip="Delete" AutomationProperties.Name="Delete function">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                </Button>
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="4,0,2,0"
                                                          ToolTip="Show on the graph" AutomationProperties.Name="Show on the graph"/>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Foreground="{DynamicResource Brush.TextMuted}"
                                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="{StaticResource MonoFont}"/>
                                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14.5"
                                                         FontFamily="Cambria Math, Segoe UI" MinHeight="32" Padding="7,4" Tag="{Binding}"
                                                         GotKeyboardFocus="RowBox_GotFocus" KeyDown="RowBox_KeyDown"
                                                         AutomationProperties.Name="{Binding Label}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Hint}" Margin="30,4,0,0" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{Binding HintBrush}" Visibility="{Binding HintVisibility}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ================= The graph ================= -->
        <DockPanel Grid.Column="2">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button x:Name="ZoomButton" Style="{StaticResource ToolButton}" Click="Zoom_Click" ToolTip="Zoom presets (like the TI-84 ZOOM menu)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71E;" FontSize="14" Margin="0,0,7,0"/>
                        <TextBlock Text="Zoom"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="7,1,0,0"/>
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="TraceToggle" Style="{StaticResource IconToggle}" Margin="0,0,6,0" Click="Trace_Click" ToolTip="Trace (arrow keys move along the curve; up and down switch curves)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7C9;" FontSize="14" Margin="0,0,7,0"/>
                        <TextBlock Text="Trace"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="PoiToggle" Style="{StaticResource IconToggle}" Margin="0,0,6,0" IsChecked="True" Click="Poi_Click"
                              ToolTip="Show zeros, turning points and intersections. Click one to keep its label.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9F8;" FontSize="14" Margin="0,0,7,0"/>
                        <TextBlock Text="Key points"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="GridToggle" Style="{StaticResource IconToggle}" Margin="0,0,6,0" IsChecked="True" Click="Grid_Click" ToolTip="Grid lines">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" FontSize="14"/>
                </ToggleButton>
                <Button Style="{StaticResource ToolButton}" Width="36" Padding="0" Click="CopyImage_Click" ToolTip="Copy the graph as a picture" AutomationProperties.Name="Copy graph picture">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Width="36" Padding="0" Click="SaveImage_Click" ToolTip="Save the graph as a PNG picture" AutomationProperties.Name="Save graph picture">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14"/>
                </Button>
                <ToggleButton x:Name="SideToggle" Style="{StaticResource IconToggle}" IsChecked="True" Click="Side_Click" ToolTip="Analyze, table and window panel">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D4;" FontSize="14"/>
                </ToggleButton>
            </WrapPanel>

            <Border DockPanel.Dock="Bottom" Margin="2,8,0,0">
                <DockPanel>
                    <TextBlock x:Name="AngleText" DockPanel.Dock="Right" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="StatusLine" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"
                               Text="Drag to move · scroll to zoom · Shift+drag to zoom to a box"/>
                </DockPanel>
            </Border>

            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="14">
                <Border CornerRadius="13" ClipToBounds="True" Margin="1">
                    <v:GraphCanvas x:Name="Canvas" AutomationProperties.Name="Graph"/>
                </Border>
            </Border>
        </DockPanel>

        <!-- ================= Analyze / Table / Window ================= -->
        <Border x:Name="SidePanel" Grid.Column="3" Style="{StaticResource Card}" Margin="16,0,0,0" Padding="16,14">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <RadioButton x:Name="TabAnalyze" Style="{StaticResource ChipRadio}" GroupName="side" Content="Analyze" IsChecked="True" Click="SideTab_Click"/>
                    <RadioButton x:Name="TabTable" Style="{StaticResource ChipRadio}" GroupName="side" Content="Table" Click="SideTab_Click"/>
                    <RadioButton x:Name="TabWindow" Style="{StaticResource ChipRadio}" GroupName="side" Content="Window" Click="SideTab_Click"/>
                </WrapPanel>

                <Grid>
                    <!-- Analyze (TI-84 CALC menu) -->
                    <ScrollViewer x:Name="AnalyzePanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="FUNCTION" Style="{StaticResource SectionLabel}"/>
                            <ComboBox x:Name="AnalyzeRow" Margin="0,0,0,10" AutomationProperties.Name="Function to analyze"/>
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,4,6" Content="Zeros" Click="Zeros_Click"/>
                                <Button Style="{StaticResource GhostButton}" Margin="4,0,0,6" Content="y-intercept" Click="YIntercept_Click"/>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,4,6" Content="Minimum" Click="Minimum_Click"/>
                                <Button Style="{StaticResource GhostButton}" Margin="4,0,0,6" Content="Maximum" Click="Maximum_Click"/>
                            </UniformGrid>
                            <TextBlock Text="INTERSECTION WITH" Style="{StaticResource SectionLabel}" Margin="0,8,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Find" Margin="6,0,0,0" Click="Intersect_Click"/>
                                <ComboBox x:Name="AnalyzeRow2" AutomationProperties.Name="Second function"/>
                            </DockPanel>
                            <TextBlock Text="AT x =" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
                            <DockPanel>
                                <TextBox x:Name="AtX" Width="90" Text="1" DockPanel.Dock="Left" AutomationProperties.Name="x value"/>
                                <UniformGrid Columns="2" Margin="6,0,0,0">
                                    <Button Style="{StaticResource GhostButton}" Margin="0,0,3,0" Padding="4,8" Content="Value" Click="Value_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Margin="3,0,0,0" Padding="4,8" Content="dy/dx" Click="Derivative_Click"/>
                                </UniformGrid>
                            </DockPanel>
                            <TextBlock Text="∫ f(x) dx FROM … TO" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="∫" FontSize="15" Margin="6,0,0,0" Click="Integral_Click"/>
                                <UniformGrid Columns="2">
                                    <TextBox x:Name="IntA" Text="0" Margin="0,0,3,0" AutomationProperties.Name="Lower bound"/>
                                    <TextBox x:Name="IntB" Text="1" Margin="3,0,0,0" AutomationProperties.Name="Upper bound"/>
                                </UniformGrid>
                            </DockPanel>

                            <DockPanel Margin="0,18,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Clear" Click="ClearMarks_Click"/>
                                <TextBlock Text="RESULTS" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="NoResults" Style="{StaticResource Hint}" Text="Pick a function and an action. Results are marked on the graph."/>
                            <ItemsControl x:Name="ResultList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" FontFamily="{StaticResource DisplayFont}" FontSize="14.5"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Table (TI-84 TABLE) -->
                    <DockPanel x:Name="TablePanel" Visibility="Collapsed">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="START" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TblStart" Text="-3" TextChanged="Table_Changed" AutomationProperties.Name="Table start"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="STEP (ΔTbl)" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TblStep" Text="1" TextChanged="Table_Changed" AutomationProperties.Name="Table step"/>
                            </StackPanel>
                        </Grid>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1.5" Padding="0,0,0,6">
                            <ItemsControl x:Name="TableHeader">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,6,0" FontFamily="{StaticResource MonoFont}" FontSize="12.5"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TableRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,5">
                                            <ItemsControl ItemsSource="{Binding}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding}" HorizontalAlignment="Right" Margin="0,0,6,0" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Window (TI-84 WINDOW) -->
                    <ScrollViewer x:Name="WindowPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid x:Name="WindowGrid">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            </Grid>
                            <TextBlock Text="ANGLES" Style="{StaticResource SectionLabel}" Margin="0,14,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadiansRadio" Content="Radians" GroupName="angle" Margin="0,0,18,0" Click="Angle_Click"/>
                                <RadioButton x:Name="DegreesRadio" Content="Degrees" GroupName="angle" Click="Angle_Click"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Shared with the Scientific page, like the MODE setting on a TI-84."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
