<UserControl x:Class="Sumthing.Views.ConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="WHAT TO CONVERT" Style="{StaticResource SectionLabel}"/>
                    <ComboBox x:Name="CategoryBox" SelectionChanged="Category_Changed" AutomationProperties.Name="What to convert"/>

                    <TextBlock Text="FROM" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
                    <TextBox x:Name="FromValue" FontSize="26" FontFamily="{StaticResource DisplayFont}" Text="1" MinHeight="52"
                             TextChanged="Value_Changed" AutomationProperties.Name="Amount to convert"/>
                    <ComboBox x:Name="FromUnit" Margin="0,8,0,0" SelectionChanged="Unit_Changed" AutomationProperties.Name="From unit"/>

                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Center" Margin="0,12" Click="Swap_Click"
                            ToolTip="Swap" AutomationProperties.Name="Swap units">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8CB;" FontSize="15"/>
                    </Button>

                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Copy" Click="CopyResult_Click"/>
                        <TextBlock Text="TO" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="10" Padding="14,10">
                        <TextBlock x:Name="ToValue" Style="{StaticResource BigResult}" FontSize="26" Text="0" AutomationProperties.Name="Converted amount"/>
                    </Border>
                    <ComboBox x:Name="ToUnit" Margin="0,8,0,0" SelectionChanged="Unit_Changed" AutomationProperties.Name="To unit"/>
                    <TextBlock x:Name="RateLine" Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border x:Name="CurrencyBar" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,14" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Update rates" Click="Refresh_Click" Margin="10,0,0,0"/>
                    <TextBlock x:Name="RatesStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Every unit at once" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AllList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="2,7">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource ResultRowValue}" Margin="12,0,0,0"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ResultRowLabel}" Margin="0" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
