<UserControl x:Class="Sumthing.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Padding="10,0" Height="34" MinHeight="0" Margin="0,0,6,0" Content="Example data" Click="Example_Click"
                                ToolTip="Fill L1 and L2 with a small example"/>
                        <Button Style="{StaticResource GhostButton}" Padding="10,0" Height="34" MinHeight="0" Content="Clear all" Click="ClearAll_Click"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Lists" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="One number per line (or paste a column from a spreadsheet). Shared with Scientific: mean(L1)."/>
                    </StackPanel>
                </DockPanel>
                <UniformGrid x:Name="ListGrid" Columns="6" Rows="1"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Calculate" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,6">
                        <RadioButton x:Name="Mode1" Style="{StaticResource ChipRadio}" GroupName="stat" Content="1-Var Stats" IsChecked="True" Click="Mode_Click"/>
                        <RadioButton x:Name="Mode2" Style="{StaticResource ChipRadio}" GroupName="stat" Content="2-Var Stats" Click="Mode_Click"/>
                        <RadioButton x:Name="ModeReg" Style="{StaticResource ChipRadio}" GroupName="stat" Content="Regression" Click="Mode_Click"/>
                    </WrapPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="XLabel" Text="LIST" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="XList" AutomationProperties.Name="X list"/>
                        </StackPanel>
                        <StackPanel x:Name="YPanel" Grid.Column="2" Visibility="Collapsed">
                            <TextBlock Text="Y LIST" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="YList" AutomationProperties.Name="Y list"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="ModelPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="MODEL" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ModelBox" AutomationProperties.Name="Regression model"/>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="Calculate" Margin="0,14,0,0" HorizontalAlignment="Left" Click="Calculate_Click"/>

                    <TextBlock x:Name="ResultTitle" Style="{StaticResource SectionLabel}" Margin="0,18,0,4"/>
                    <TextBlock x:Name="ResultEquation" FontFamily="Cambria Math, Segoe UI" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="ResultRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource ValueText}"/>
                                        <TextBlock Text="{Binding Name}" FontFamily="Cambria Math, Segoe UI" FontSize="14.5"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <StackPanel x:Name="PlotButtons" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                        <Button Style="{StaticResource GhostButton}" Click="Plot_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9A6;" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock x:Name="PlotText" Text="Plot on Graphing"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
